# Server Configuration
NODE_ENV=development
PORT=10000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/sofia_db

# Security (required -- the server refuses to start if either is unset)
JWT_SECRET=your-very-secure-jwt-secret-key-here
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# Claude API (required for the /api/chat conversation engine)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-5

# Optional tuning for the chat context window/cost controls (see backend/routes/chat.js)
CHAT_CONTEXT_MESSAGE_LIMIT=30
CHAT_CONTEXT_CAP_REALERT_INTERVAL=50

# Clinical Alerts (Optional)
CLINICIAN_WEBHOOK_URL=https://your-clinical-system.com/webhooks/alerts
CLINICIAN_EMAIL=dr.thompson@healthsystem.org

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@sofia-app.com
SMTP_PASS=your-smtp-password
