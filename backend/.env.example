# Server Configuration
NODE_ENV=development
PORT=10000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/sofia_db
# Managed Postgres on providers like Render presents a self-signed cert on
# its internal network -- leave this unset (defaults to false) there, or
# the app can't connect at all (DEPTH_ZERO_SELF_SIGNED_CERT). Only set to
# true when hosting somewhere with a real CA-signed DB certificate.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Security (required -- the server refuses to start if either is unset)
JWT_SECRET=your-very-secure-jwt-secret-key-here
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# Conversation engine (/api/chat) -- LLM provider selection.
# Defaults to "openai" because, as of this writing, there is a signed BAA
# covering OpenAI API usage but not yet one with Anthropic -- do not switch
# to "anthropic" for real PHI-bearing traffic until that's in place.
LLM_PROVIDER=openai

# OpenAI API (required when LLM_PROVIDER=openai, the default)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Claude API (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-5

# Optional tuning for the chat context window/cost controls (see backend/routes/chat.js)
CHAT_CONTEXT_MESSAGE_LIMIT=30
CHAT_CONTEXT_CAP_REALERT_INTERVAL=50

# Data retention (see backend/scripts/purge-retention.js, `npm run purge-retention`).
# Run this on a schedule (e.g. a daily cron job) -- it is not automatic.
AUDIT_LOG_RETENTION_DAYS=365
# Unset by default -- only purges deactivated accounts if explicitly set;
# never deletes an active account without the user's own DELETE /api/users/me.
# INACTIVE_ACCOUNT_PURGE_DAYS=90

# Clinical Alerts (Optional)
CLINICIAN_WEBHOOK_URL=https://your-clinical-system.com/webhooks/alerts
CLINICIAN_EMAIL=dr.thompson@healthsystem.org

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@sofia-app.com
SMTP_PASS=your-smtp-password
